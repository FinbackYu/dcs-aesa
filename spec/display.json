  "known_conflicts": [
    {
      "id": "db_float_floor_vs_int8_floor",
      "topic": "-40 dB 浮点下限与 -127 Int8 有效下限不是同一件事",
      "evidence": [
        "tools/sar_map.cjs:637-638 clamps float dB to -40",
        "tools/sar_live.cjs:285 clamps Int8 to -127 while -128 is no data",
        "docs/conventions.md:523 explains -40 dB quantises to -127, and -127 cannot be read back as -40"
      ],
      "resolution": "spec 同时保留 floor_db=-40 与 clamp_min=-127，并记录换算关系；显示层不得从 -127 反推 -40"
    }
  ]
