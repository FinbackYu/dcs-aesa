  "known_conflicts": [
    {
      "id": "mapgrid_undocumented",
      "topic": "Export 发送 MAPGRID，但 docs/conventions.md §8.3 的行表没有列出",
      "evidence": [
        "src/export/aesa_sar_export.lua:188 sends MAPGRID,<id>,col_x_row_z",
        "tools/sar_live.cjs:145 accepts MAPGRID",
        "docs/conventions.md:598-602 lists MAPBEGIN/MAPHEIGHT/... but no MAPGRID"
      ],
      "resolution": "spec/protocol.json 记录 MAPGRID 3 字段；文档缺口留给后续文档修订，不改变协议"
    },
    {
      "id": "architecture_stale_aa_fields",
      "topic": "docs/architecture.md §4.2 仍描述 Gate 1 前的 T 行 Country 与 velocity 字段",
      "evidence": [
        "docs/architecture.md:336 says T uses coalition/Country/country and obj.velocity/vel",
        "src/export/aesa_export.lua:83-89 now reads CoalitionID",
        "src/export/aesa_export.lua:105-108 uses LoGetVectorVelocity"
      ],
      "resolution": "以代码与 docs/conventions.md §8.2 为准；本任务不改架构文档，只在 spec 记录冲突"
    },
    {
      "id": "aa_p_row_no_max",
      "topic": "A/A P 行没有显式长度上限",
      "evidence": [
        "src/export/aesa_export.lua:129 sends 'P '..probe text",
        "tools/receiver.py:79-80 accepts kind P with any tail"
      ],
      "resolution": "protocol.json 记录 min_fields=2、aa_line_max_chars=null（代码无上限），不发明一个上限"
    }
  ]
