  "known_conflicts": [
    {
      "id": "zero_notch_not_configured",
      "topic": "zero_notch_half_ms 在原核心 physics.lua 中可选、原 config.lua 未配置（现为 core/detection.lua + 生成配置）",
      "evidence": [
        "src/core/detection.lua:42-43 treats pe.zero_notch_half_mps <= 0 as disabled",
        "Gate 2 前旧核心配置（文件已删除）没有 zero_notch_half_ms；现 spec/radar.json 显式写出 zero_notch_half_mps=0.0"
      ],
      "resolution": "spec 显式写出 zero_notch_half_mps=0.0，来源标为 code_default；不是新增行为"
    },
    {
      "id": "gate_accel_margin_unit",
      "topic": "gate_accel_margin_ms 名称写 ms，实际单位是 m/s（现已改名 gate_accel_margin_mps）",
      "evidence": [
        "Gate 2 前旧配置 gate_accel_margin_ms = 300.0（文件已删除）",
        "docs/conventions.md 曾漏列 gate_accel_margin_ms；现配置键为 tracker.gate_accel_margin_mps"
      ],
      "resolution": "spec 改为 gate_accel_margin_mps；数值不变"
    }
