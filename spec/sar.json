  "known_conflicts": [
    {
      "id": "map_looks_default",
      "topic": "MAP 多视默认值在引擎与服务两层不同",
      "evidence": [
        "tools/sar_map.cjs:49 DEFAULTS.looks=1",
        "tools/sar_live.cjs:679 MAP_DEFAULTS.looks=4"
      ],
      "resolution": "spec 同时保留 engine_defaults.looks=1 与 service_defaults.looks=4；消费者必须显式传服务默认值，本任务不擅自统一"
    },
    {
      "id": "map_cells_default",
      "topic": "MAP 格数默认值在引擎与服务两层不同",
      "evidence": [
        "tools/sar_map.cjs:49 DEFAULTS.cells=121",
        "tools/sar_live.cjs:697 cfg.cells=mapEngine.sectorGrid({range_m,cell_m})（默认 20 km/250 m → 161）"
      ],
      "resolution": "spec 保留引擎默认 121，并记录服务端派生规则；不把 121 当成服务默认"
    },
    {
      "id": "map_serving_defaults_not_passed",
      "topic": "sar_map 的 looks/cells 默认只在调用方不传时生效",
      "evidence": [
        "tools/sar_live.cjs:693-700 显式构造 cfg 后传给 sar_map",
        "tools/sar_map.cjs:60 cfg={...DEFAULTS,...input}"
      ],
      "resolution": "生成配置同时提供 engine_defaults 与 service_defaults，迁移时不得只取一份"
    }
  ]
