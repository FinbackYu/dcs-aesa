  "known_conflicts": [
    {
      "id": "js_generated_location",
      "topic": "JS 生成配置落点：计划写 tools/generated，架构 A-13 推荐 src/shared",
      "evidence": [
        "docs/refactor-plan.md:376-377 lists src/shared/config.lua/protocol.lua and tools/generated/config.cjs",
        "docs/architecture.md:661-669 notes the JS generated location is not final",
        "docs/architecture.md:887-895 A-13 recommends src/shared/config.cjs",
        "this task explicitly requires tools/generated/config.cjs"
      ],
      "resolution": "Gate 2 按任务要求生成 tools/generated/config.cjs；Gate 5 已迁到 src/shared/config.cjs 并删除旧路径，tools 与测试统一 require 新落点，src/sar_core 不 import tools/"
    },
    {
      "id": "fc_backup_suffix",
      "topic": "FC 安装器复用 SAR 的 .bak-aesa-sar 后缀",
      "evidence": [
        "Gate 0–5: scripts/install_fc_probe.cjs 从 install_sar.cjs 复用 backup()",
        "Gate 6: scripts/install_common.cjs:11 BACKUP_SUFFIX=.bak-aesa"
      ],
      "resolution": "Gate 6 已统一为 .bak-aesa（install_common.BACKUP_SUFFIX）；旧 .bak-aesa-sar 备份保留但不再新写"
    },
    {
      "id": "scene_backup_suffix",
      "topic": "场景 Hook 安装器复用 SAR 备份后缀",
      "evidence": [
        "Gate 0–5: scripts/install_sar_scene.cjs 从 install_sar.cjs 复用 backup()",
        "Gate 6: install_sar_scene.cjs 直接 require install_common.cjs"
      ],
      "resolution": "Gate 6 已统一为 .bak-aesa；场景 Hook 改用 install_common"
    },
    {
      "id": "fc_native_hardcoded_saved_games",
      "topic": "FC 原生 DLL 硬编码 Saved Games\\DCS，与安装器 --saved-games 可指向 openbeta/临时目录不一致",
      "evidence": [
        "src/native/fc_probe/aesa_fc.c:107 getenv USERPROFILE + Saved Games\\DCS\\Logs\\AESA（独立 ctypes 烟测兜底）",
        "src/hooks/aesa_fc_hook.lua:309 pcall(init,base..\"Logs\\AESA\") 总是传 writedir"
      ],
      "resolution": "hook 总是把 writedir 下的 Logs\\AESA 传给 init；原生 getenv 分支只用于独立 ctypes 烟测，不影响 --saved-games 部署"
    }
  ]
